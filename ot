#!/usr/bin/env python3
"""onethread entry point: python3 ot <command>  (or put this folder on PATH)."""
import os
import sys

if sys.version_info < (3, 9):
    sys.exit("ot needs Python 3.9 or newer (macOS's own python3 is fine).")

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from onethread.cli import main  # noqa: E402

sys.exit(main())
